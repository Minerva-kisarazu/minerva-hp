# 本番サイトのURL（末尾スラッシュなし）
# Cloudflare Pages 本番では Production 環境に設定（sitemap / robots / 印刷QR に使用）
# 例: https://minerva-hp.pages.dev または独自ドメイン
NEXT_PUBLIC_SITE_URL=

# Google Apps Script のウェブアプリ URL（総合問い合わせフォーム用）
# https://script.google.com でスタンドアロン新規プロジェクトを作り
# scripts/google-sheets-contact.gs をデプロイした URL を設定する
# Cloudflare Pages では「環境変数（シークレット）」として設定（Functions が参照）
# （スプレッドシートの「拡張機能→Apps Script」は Jimdo用。触らない）
GOOGLE_SHEETS_WEBAPP_URL=

# 公式LINE
NEXT_PUBLIC_LINE_URL=https://lin.ee/YJ3KMWg

# Googleカレンダー予約ページ（新しいタブで開く用）
NEXT_PUBLIC_GOOGLE_CALENDAR_BOOKING_URL=https://calendar.app.google/WyRL3eqXMN7dAYLk7

# Googleカレンダー予約 iframe 埋め込みURL
NEXT_PUBLIC_GOOGLE_CALENDAR_EMBED_URL=https://calendar.google.com/calendar/appointments/schedules/AcZssZ28uAPiv4l_lHKycK6NJfqNHbzej_ij-jmY8C3TtmpLBaLl-YsGjMuvZQZTTGZKwF1bq7g2UKBc?gv=true
